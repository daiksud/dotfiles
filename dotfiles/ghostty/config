background-image = hololive-en-advent.jpg
background-image-fit = cover
background-image-opacity = 0.06
background-image-position = center
command = shell:~/.config/ghostty/herdr-launch.sh
font-family = Moralerspace Neon HW
font-size = 13.5
fullscreen = non-native-visible-menu
macos-non-native-fullscreen = visible-menu
macos-option-as-alt = true
macos-titlebar-style = hidden
mouse-hide-while-typing = true
theme = TokyoNight Storm
window-inherit-working-directory = false
window-padding-y = 0

# Disable tab-related keybinds
keybind = super+t=unbind
keybind = super+shift+left_bracket=unbind
keybind = super+shift+right_bracket=unbind
keybind = super+one=unbind
keybind = super+two=unbind
keybind = super+three=unbind
keybind = super+four=unbind
keybind = super+five=unbind
keybind = super+six=unbind
keybind = super+seven=unbind
keybind = super+eight=unbind
keybind = super+nine=unbind

# Disable split-related keybinds
keybind = super+d=unbind
keybind = super+shift+d=unbind
keybind = super+opt+up=unbind
keybind = super+opt+down=unbind
keybind = super+opt+left=unbind
keybind = super+opt+right=unbind
keybind = super+ctrl+up=unbind
keybind = super+ctrl+down=unbind
keybind = super+ctrl+left=unbind
keybind = super+ctrl+right=unbind
keybind = super+shift+enter=unbind

# Remap ctrl+e to the End key
#
# Plan モード終盤の Plan Ready for Review ダイアログは ctrl+e を summary と full plan
# の切り替えに使うため、入力欄で end-of-line として使えない。End キー (CSI F) は
# このハンドラに横取りされず、TextInput の行末移動として処理される。
#
# 代償として Copilot CLI などの生の Ctrl+E (0x05) は ctrl+alt+e へ退避する。
keybind = ctrl+e=csi:F
keybind = ctrl+alt+e=text:\x05

# Remap ctrl+d to the Delete key
#
# Copilot CLI の ask_user / elicitation フォームは ctrl+d を無条件に "decline"
# にバインドしており、入力済みテキストごとダイアログを破棄する。テキストの有無を
# ガードしていないため、Emacs の delete-char のつもりで押すと回答が失われる。
# 一方 Delete キー (CSI 3~) は横取りされず前方削除として処理される。
# ctrl+b の衝突を herdr のプレフィックス移動で解決したのと同じ方針で、
# ここでは端末層で ctrl+d を Delete に変換して delete-char 相当を取り戻す。
#
# 代償として ctrl+d が EOF (0x04) を送らなくなるので、EOF は ctrl+alt+d へ退避する。
# copilot の終了は /exit、$ シェルからの復帰は exit を使う。
keybind = ctrl+d=csi:3~
keybind = ctrl+alt+d=text:\x04
