# Homebrew
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Completion system (must be before sheldon so plugins can use compdef)
autoload -Uz compinit
compinit

# Emacs keybindings
bindkey -e

# Ghostty で ctrl+e を End キー (CSI F) に変換しているため、zsh 側で
# 受け取れるようにする。素の zsh では ^[[F は undefined-key で無反応。
bindkey '^[[F' end-of-line

# Ghostty で ctrl+d を Delete キー (CSI 3~) に変換しているため、zsh 側で
# 受け取れるようにする。素の zsh では ^[[3~ は undefined-key で無反応。
bindkey '^[[3~' delete-char

# 多重の安全弁。Ghostty 設定が効かない環境 (SSH 先、他ターミナル) で ctrl+d が
# 0x04 のまま届いた場合でも、シェルが即終了しないようにする。
setopt IGNORE_EOF

# Sheldon plugin manager
eval "$(sheldon source)"

# History
setopt extended_history
setopt hist_ignore_all_dups
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_reduce_blanks
setopt hist_verify
setopt share_history

# Directory
setopt auto_cd
setopt auto_pushd
setopt pushd_ignore_dups

# Completion style (case-insensitive, hyphen-insensitive)
zstyle ':completion:*' matcher-list 'm:{a-zA-Z-_}={A-Za-z_-}'

# Editor
export EDITOR='nvim'

# Copilot CLI の ctrl+y は補完確定と「plan/リサーチレポートを $EDITOR で開く」の
# 二役を持つ。Emacs の yank のつもりで押すとエディタが開いてしまうため、
# 即座に終了するコマンドを指定して誤爆を no-op 化する。
export COPILOT_EDITOR=/usr/bin/true

# Starship prompt
eval "$(starship init zsh)"

# mise (runtime version manager)
eval "$(mise activate zsh)"

# Custom functions
if [[ -d $HOME/.zsh ]]; then
  for file in $HOME/.zsh/*.zsh; do
    source "$file"
  done
fi

# Vite+ bin (https://viteplus.dev)
if [[ -f "$HOME/.vite-plus/env" ]]; then
  . "$HOME/.vite-plus/env"
fi
