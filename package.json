{
  "name": "dotfiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:install": "vp -C .docusaurus install",
    "docs:start": "vp -C .docusaurus run start",
    "docs:build": "vp -C .docusaurus run build",
    "docs:serve": "vp -C .docusaurus run serve"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.3.14",
      "onFail": "download"
    }
  }
}
