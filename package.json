{
  "name": "dotfiles",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:install": "bun install --cwd .docusaurus --frozen-lockfile",
    "docs:start": "bun run --cwd .docusaurus start",
    "docs:build": "bun run --cwd .docusaurus build",
    "docs:serve": "bun run --cwd .docusaurus serve"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
